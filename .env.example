# ============================================
# CONFIGURATION — Ma Sadaqa (masadaqa.com)
# ============================================

# Port sur lequel tourne le serveur Express
PORT=3000

# URL publique de ton site (sans slash final)
# En dev : http://localhost:3000
# En prod : https://masadaqa.com
BASE_URL=http://localhost:3000

# ============================================
# PAYRAM — PROCESSEUR DE PAIEMENT
# ============================================

# Clé API PayRam (générée dans le dashboard PayRam)
PAYRAM_SECRET_KEY=REMPLACE_MOI_par_ta_cle_api

# URL de ton instance PayRam self-hosted
PAYRAM_API_URL=http://TON_IP:8080

# Secret HMAC pour la vérification des webhooks PayRam
PAYRAM_WEBHOOK_SECRET=whsec_REMPLACE_MOI_par_ton_secret_webhook

# ============================================
# TELEGRAM — NOTIFICATIONS
# ============================================

# Bot token Telegram (créé via @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID pour recevoir les notifications (ton ID ou un group ID)
TELEGRAM_CHAT_ID=

# ============================================
# ADMINISTRATION
# ============================================

# Mot de passe pour accéder au back-office (/admin)
# Change cette valeur IMMÉDIATEMENT en production !
ADMIN_PASSWORD=admin123

# ============================================
# BASE DE DONNÉES
# ============================================

# Chemin vers le fichier SQLite (relatif à la racine du projet)
DATABASE_PATH=db/cagnottes.db
